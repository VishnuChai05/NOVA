# Core
ENVIRONMENT=prod
APP_NAME=NOVA

# Security
API_AUTH_ENABLED=true
OPERATIONAL_API_KEY=replace-with-a-long-random-key

# CORS (public app URL)
FRONTEND_URL=https://your-domain.com

# Background job queue
REDIS_URL=redis://redis:6379/0
SCRAPE_JOB_QUEUE_NAME=scrape
SCRAPE_JOB_TIMEOUT_SECONDS=7200

# Frontend build-time API key header value
VITE_API_KEY=replace-with-the-same-api-key-or-empty-if-auth-disabled

# LLM providers
ENGINE_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Scraper integrations
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nova-content-engine/1.0
REDDIT_SOURCE_MODE=auto

APIFY_API_TOKEN=
APIFY_REDDIT_ACTOR_ID=apify/google-search-scraper
APIFY_QUORA_ACTOR_ID=apify/google-search-scraper
APIFY_ACTOR_ID=apify/google-search-scraper

# Scraper behavior
ALLOW_FALLBACK_SEED_DATA=true
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_BACKOFF_BASE_SECONDS=1.0
REDDIT_QUERY_DELAY_SECONDS=0.35
SCRAPE_PARALLEL_MAX_WORKERS=4
SCRAPE_REDDIT_TIMEOUT_SECONDS=180
SCRAPE_QUORA_TIMEOUT_SECONDS=180
SCRAPE_FORUM_TIMEOUT_SECONDS=240
SCRAPE_BLOG_TIMEOUT_SECONDS=360
SCRAPE_RELEVANCE_MIN_SCORE=2
SCRAPE_TOPIC_CLASSIFIER_PROVIDER=template
BLOG_CRAWL_MAX_URLS_PER_DOMAIN=120
BLOG_CRAWL_TIMEOUT_SECONDS=10.0
INSIGHT_VALIDATOR_PROVIDER=template
INSIGHT_MAX_SUGGESTIONS=5

# Compliance / scheduling
COMPLIANCE_PURGE_ENABLED=false
SCRAPED_DATA_RETENTION_DAYS=30
CONTINUOUS_SCRAPE_ENABLED=false
CONTINUOUS_SCRAPE_INTERVAL_MINUTES=60
